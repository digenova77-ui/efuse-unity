#!/usr/bin/env python3
"""swarm-merge — merge two lane attestation chains into one verdict log.

The merge point of the two-lane loop. Reads two exported chains
(`attest.py --export` output, one canonical record per line), verifies each
chain's hashes, and merges:

  - Records interleave by (at_utc, lane, seq).
  - A chain that fails verification is quarantined: records after the break
    are kept but flagged QUARANTINED, and the break is reported.
  - Conflicts — same claim, different verdict_hash from the two lanes — are
    NEVER silently overwritten. Both records are kept and the claim is marked
    DISPUTED for elevation.

Merge rule (standing law): proof wins; newer attestations chain to older;
disputed items elevate.

Usage:
  swarm-merge laneA.jsonl laneB.jsonl [--out merged.jsonl]
  Reads files of canonical attestation records (or - for stdin, twice needs files).
  Prints the merged log as canonical JSON lines, then a summary to stderr.
"""
import json
import sys


def load(path):
    recs = []
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                recs.append(json.loads(line))
    return recs


def verify_chain(recs):
    """Returns (ok_up_to_index, break_detail)."""
    import hashlib
    prev = "GENESIS"
    for i, r in enumerate(recs):
        if r.get("prev_hash") != prev:
            return i, "prev_hash mismatch at seq %s" % r.get("seq")
        body = {k: v for k, v in r.items() if k != "hash"}
        canon = json.dumps(body, sort_keys=True, separators=(",", ":"),
                           ensure_ascii=False)
        if hashlib.sha256(canon.encode()).hexdigest() != r.get("hash"):
            return i, "hash mismatch at seq %s" % r.get("seq")
        prev = r["hash"]
    return len(recs), "valid"


def main(argv):
    out_path = None
    paths = []
    i = 0
    while i < len(argv):
        if argv[i] == "--out" and i + 1 < len(argv):
            out_path = argv[i + 1]
            i += 2
        else:
            paths.append(argv[i])
            i += 1
    if len(paths) != 2:
        print("usage: swarm-merge laneA.jsonl laneB.jsonl [--out merged.jsonl]",
              file=sys.stderr)
        return 2

    lanes = []
    for p in paths:
        recs = load(p)
        ok_n, detail = verify_chain(recs)
        lanes.append({"path": p, "records": recs, "valid_n": ok_n,
                      "detail": detail})

    merged = []
    quarantined = 0
    for L in lanes:
        for j, r in enumerate(L["records"]):
            r = dict(r)
            if j >= L["valid_n"]:
                r["_merge_flag"] = "QUARANTINED"
                quarantined += 1
            merged.append(r)

    # Conflict detection: same claim, different verdict_hash across lanes.
    seen = {}
    disputed = set()
    for r in merged:
        lane = r.get("lane")
        for claim, vh in (r.get("verdict_hashes") or {}).items():
            key = claim
            if key in seen and seen[key] != vh:
                disputed.add(key)
            seen.setdefault(key, vh)
    for r in merged:
        vhs = r.get("verdict_hashes") or {}
        if any(c in disputed for c in vhs):
            r["_merge_flag"] = (r.get("_merge_flag") or "") + "+DISPUTED" \
                if r.get("_merge_flag") else "DISPUTED"

    merged.sort(key=lambda r: (r.get("at_utc", ""), r.get("lane", ""),
                               r.get("seq", 0)))

    out = open(out_path, "w", encoding="utf-8") if out_path else sys.stdout
    for r in merged:
        out.write(json.dumps(r, sort_keys=True, separators=(",", ":"),
                             ensure_ascii=False) + "\n")
    if out_path:
        out.close()

    summary = {
        "records_merged": len(merged),
        "lanes": [{"path": L["path"], "records": len(L["records"]),
                   "chain": L["detail"]} for L in lanes],
        "quarantined": quarantined,
        "disputed_claims": sorted(disputed),
        "rule": "proof wins; newer chains to older; disputes elevate, never overwritten",
    }
    print(json.dumps(summary, indent=2), file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
