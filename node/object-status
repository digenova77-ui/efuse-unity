#!/usr/bin/env bash
# object-status — one-command health check for the Amsterdam object store.
set -u
BIN=/usr/local/bin/garage
CONF=/etc/dualis/garage.toml
fail=0
say(){ echo "object-status: $*"; }

[ "$(id -u)" = "0" ] || { say "run as root: sudo object-status"; exit 1; }

if systemctl is-active -q garage.service; then say "service garage: ACTIVE"; else say "service garage: DOWN"; fail=1; fi

if [ -x "$BIN" ] && [ -f "$CONF" ]; then
  if "$BIN" -c "$CONF" status 2>/dev/null | grep -q "HEALTHY\|healthy"; then
    say "cluster: HEALTHY"
  else
    say "cluster status:"; "$BIN" -c "$CONF" status 2>/dev/null | head -6 || fail=1
  fi
  if "$BIN" -c "$CONF" bucket list 2>/dev/null | grep -q dclm-objects; then
    say "bucket dclm-objects: PRESENT"
  else say "bucket dclm-objects: MISSING"; fail=1; fi
  # S3 data path: anonymous list must be DENIED (proves auth is enforced).
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 'http://127.0.0.1:3900/dclm-objects/?list-type=2' 2>/dev/null)"
  if [ "$code" = "403" ]; then say "S3 endpoint :3900: UP (anonymous correctly denied, HTTP 403)"
  elif [ "$code" = "000" ]; then say "S3 endpoint :3900: UNREACHABLE"; fail=1
  else say "S3 endpoint :3900: unexpected HTTP $code"; fail=1; fi
else
  say "garage not installed — run the bootstrap one-liner, then: sudo object-init"; fail=1
fi

[ "$fail" = 0 ] && say "ALL CHECKS PASS" || say "CHECKS FAILED"
exit "$fail"
