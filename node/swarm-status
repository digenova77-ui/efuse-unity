#!/usr/bin/env bash
# swarm-status — show this swarm node's state. Read-only. Never changes anything.
set -u
STATE_DIR="/var/lib/dualis"
LOG="$STATE_DIR/heartbeat.jsonl"

echo "== swarm node =="
if [ -f /etc/dualis/node-id ]; then
  echo "node-id : $(cat /etc/dualis/node-id)"
else
  echo "node-id : (not initialized — run node-heartbeat.py --init as root)"
fi
echo "host    : $(hostname)"
echo "time    : $(date -u +%Y-%m-%dT%H:%M:%SZ) (UTC)"
echo
echo "== heartbeat =="
if [ -f "$LOG" ]; then
  count=$(wc -l < "$LOG" | tr -d ' ')
  echo "entries : $count"
  echo "last    :"
  tail -1 "$LOG" | python3 -m json.tool 2>/dev/null | sed 's/^/  /' || tail -1 "$LOG"
else
  echo "no heartbeats yet"
fi
echo
echo "== scheduler =="
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl is-active dualis-heartbeat.timer 2>/dev/null | sed 's/^/timer   : /'
  systemctl is-enabled dualis-heartbeat.timer 2>/dev/null | sed 's/^/enabled : /'
elif grep -q "node-heartbeat.py" /etc/cron.d/dualis-heartbeat 2>/dev/null; then
  echo "cron    : installed (/etc/cron.d/dualis-heartbeat, every 5 min)"
else
  echo "scheduler: none found"
fi
echo
echo "== code mirror =="
if [ -d /opt/dualis/code/.git ]; then
  git -C /opt/dualis/code log -1 --format='repo    : %H%nupdated : %ci' 2>/dev/null || echo "repo    : present (log unreadable)"
else
  echo "repo    : not present"
fi
