#!/usr/bin/env bash
# object-init — initialize the Amsterdam object store (lane EUROPE only).
#
# Interactive: run at the Vultr web console AFTER the bootstrap one-liner.
#   sudo object-init
#
# What it does:
#   1. Generates all secrets itself (Garage requires hex-format keys; a human
#      cannot invent them). Prints them ONCE for David to record. They are
#      never written to a log or echoed back afterward.
#   2. Writes /etc/dualis/garage.toml (root-only, mode 600).
#   3. Starts Garage as a systemd service (single node, replication_factor 1).
#   4. Assigns the cluster layout, creates the dclm-objects bucket,
#      creates the dclm-root key and grants it read/write/owner.
#   5. Seeds the bucket layout README.
#
# Idempotent: safe to run twice. A second run reports status and exits 0.
set -u

LANE_FILE=/etc/dualis/lane
CONF=/etc/dualis/garage.toml
BIN=/usr/local/bin/garage
SERVICE=garage.service

die(){ echo "object-init: ERROR: $*" >&2; exit 1; }
say(){ echo "object-init: $*"; }

[ "$(id -u)" = "0" ] || die "run as root: sudo object-init"
[ -x "$BIN" ] || die "$BIN missing — run the bootstrap one-liner first"
[ -f "$LANE_FILE" ] || die "$LANE_FILE missing — run the bootstrap one-liner first"
LANE="$(cat "$LANE_FILE")"
[ "$LANE" = "EUROPE" ] || die "object store lives on the EUROPE lane; this box is lane $LANE"

G="$BIN -c $CONF"

# ---- idempotency: already initialized? ----
if [ -f "$CONF" ] && systemctl is-active -q "$SERVICE" 2>/dev/null; then
  if $G bucket list 2>/dev/null | grep -q dclm-objects; then
    say "object store already initialized and healthy."
    $G bucket list 2>/dev/null | head -5
    say "Nothing to do. (Credentials were shown once at init and are not stored retrievably.)"
    exit 0
  fi
fi

say "Initializing the Amsterdam object store (Garage v2, S3-compatible)."
say "Secrets are generated now and shown ONCE. Have something ready to record them."
if [ -t 0 ]; then
  printf "Press Enter to generate credentials... " > /dev/tty
  read -r _ < /dev/tty
fi

RPC_SECRET="$(openssl rand -hex 32)"
ADMIN_TOKEN="$(openssl rand -hex 32)"
KEY_ID="GK$(openssl rand -hex 12)"
KEY_SECRET="$(openssl rand -hex 32)"

mkdir -p /etc/dualis /var/lib/garage/meta /var/lib/garage/data
chmod 700 /etc/dualis

# Capacity: 70% of the filesystem holding /var/lib/garage, expressed in GB.
DISK_KB="$(df -k /var/lib/garage | awk 'NR==2{print $4}')"
CAP_GB=$(( DISK_KB * 70 / 100 / 1024 / 1024 ))
[ "$CAP_GB" -ge 5 ] || CAP_GB=5

cat > "$CONF" <<EOF
# Generated by object-init on $(date -u +%FT%TZ). Root-only.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = 1
rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "$RPC_SECRET"
[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
[admin]
api_bind_addr = "127.0.0.1:3903"
admin_token = "$ADMIN_TOKEN"
EOF
chmod 600 "$CONF"

systemctl daemon-reload
systemctl enable -q "$SERVICE"
systemctl restart "$SERVICE"

say "waiting for garage to come up..."
for i in $(seq 1 30); do
  NODE_ID="$($G node id 2>/dev/null | head -1 | cut -d@ -f1)"
  [ -n "$NODE_ID" ] && break
  sleep 2
done
[ -n "$NODE_ID" ] || die "garage did not start; see: journalctl -u $SERVICE"

# Layout: assign this node storage duty if it has none yet.
if ! $G layout show 2>/dev/null | grep -q "Partitions are replicated"; then
  $G layout assign -z ams -c "${CAP_GB}G" "${NODE_ID:0:16}" \
    || die "layout assign failed"
  VER="$($G layout show 2>/dev/null | grep -o 'Current cluster layout version: [0-9]*' | grep -o '[0-9]*')"
  $G layout apply --version $((VER + 1)) \
    || die "layout apply failed; run '$G layout show' and apply manually"
  say "cluster layout applied (single node, replication 1, ${CAP_GB}G)."
else
  say "cluster layout already assigned; skipping."
fi

# Key + bucket (ignore already-exists; this is the idempotent path).
$G key import -n dclm-root --yes "$KEY_ID" "$KEY_SECRET" >/dev/null 2>&1 \
  || say "(key dclm-root already imported)"
$G bucket create dclm-objects >/dev/null 2>&1 \
  || say "(bucket dclm-objects already exists)"
$G bucket allow --read --write --owner dclm-objects --key dclm-root \
  || die "bucket allow failed"

# Seed the layout README so the bucket documents itself.
LAYOUT_DOC="$(mktemp)"
cat > "$LAYOUT_DOC" <<'DOC'
# dclm-objects — bucket layout (Amsterdam is the object authority)

dclm-objects/
  bundles/swarm-node/...            deploy bundle mirror (bootstrap.sh, node/*)
  kernels/planckos3/...             PlanckOS^3 kernel images (when built)
  snapshots/<lane>/<utc-ts>/        box snapshots
  attestations/lanes/<lane>/<date>.jsonl   per-lane attestation exports
  attestations/merged/<date>.jsonl         merged verdict logs

Rules: Amsterdam is the object authority. The NJ lane pulls (read-only key),
never pushes. Nothing here is a backup of anything elsewhere — this is the
canonical home for objects.
DOC
DCLM_S3_KEY="$KEY_ID" DCLM_S3_SECRET="$KEY_SECRET" \
  /usr/local/bin/s3.py put dclm-objects LAYOUT.md "$LAYOUT_DOC" 2>/dev/null \
  || say "(warning: could not seed LAYOUT.md — bucket still usable)"
rm -f "$LAYOUT_DOC"

echo
echo "=================================================================="
echo " OBJECT STORE LIVE. Record these now — they are shown exactly once."
echo "=================================================================="
echo " S3 endpoint : http://45.76.33.16:3900   (region: garage)"
echo " Bucket      : dclm-objects"
echo " Key ID      : $KEY_ID"
echo " Key secret  : $KEY_SECRET"
echo " Admin API   : 127.0.0.1:3903 (local only; token in $CONF)"
echo "=================================================================="
echo " Verify any time with:  object-status"
echo " S3 access from anywhere: set DCLM_S3_KEY / DCLM_S3_SECRET, then"
echo "   s3.py ls dclm-objects [prefix] | s3.py put/get ..."
